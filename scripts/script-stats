#!/usr/bin/env python3
"""Count sentences, characters, estimated duration, dictionary coverage, figures, and code refs for script.md (v1 & v2)."""

from __future__ import annotations

import argparse
from collections import Counter
import csv
from dataclasses import dataclass, field
from pathlib import Path
import re
import sys

SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

import xv6refs  # noqa: E402

DEFAULT_SCRIPT = REPO_ROOT / "video" / "ep01" / "script.md"

# v1 trailing visual cue: [画面: ...]
V1_VISUAL_CUE_RE = re.compile(r"\s*\[画面:\s*([^\]]+)\]\s*$")

# v2 speaker prefix and trailing cues: [図: ...] [コード: ...] [テロップ: ...]
SPEAKER_LINE_RE = re.compile(r"^([A-Za-z][A-Za-z0-9_]*):\s*(.*)$")
TRAILING_TAGS_RE = re.compile(r"(?:\s*\[([^\[\]:]+):\s*([^\[\]]+)\])+\s*$")
SINGLE_TAG_RE = re.compile(r"\[([^\[\]:]+):\s*([^\[\]]+)\]")
FIG_SPEC_RE = re.compile(r"^([a-z0-9]+(?:-[a-z0-9]+)*)(?:#([1-9][0-9]*))?$")
FIG_HEADING_RE = re.compile(r"^##\s+`?([a-z0-9]+(?:-[a-z0-9]+)*)`?(?:\s|$|—|-|:)")

V2_TAG_ORDER = ("図", "コード", "テロップ")

ASCII_TOKEN_RE = re.compile(r"[A-Za-z][A-Za-z0-9_-]*")
PUNCT_RE = re.compile(r"[、。！？!?「」『』（）()・…―〜\s]")
COMMENT_CUE_RE = re.compile(r"^<!--\s*(SE|BGM|間)\s*:\s*(.*?)\s*-->$")
PAUSE_SEC_RE = re.compile(r"(\d+(?:\.\d+)?)\s*秒")

FORBIDDEN_AUDIO_PHRASES = (
    "この図",
    "こちらの図",
    "上の図",
    "下の図",
    "左の図",
    "右の図",
    "右側の図",
    "左側の図",
    "次の図",
    "さっきの図",
    "図のように",
    "図の通り",
    "図のとおり",
    "図を見て",
    "上のコード",
    "下のコード",
    "こちらのコード",
    "このコード",
    "画面の通り",
    "画面のとおり",
    "画面を見て",
    "画面に出ている",
    "ご覧の",
    "見てわかる通り",
    "赤枠",
)


@dataclass
class SpokenLine:
    lineno: int
    spoken: str
    speaker: str | None = None
    visual: str | None = None       # v1 [画面: ...]
    fig_ref: str | None = None      # v2 [図: ...]
    code_ref: str | None = None     # v2 [コード: ...]
    telop: str | None = None        # v2 [テロップ: ...]


@dataclass
class SectionStats:
    title: str
    lines: list[SpokenLine] = field(default_factory=list)

    @property
    def chars(self) -> int:
        return sum(len(re.sub(r"\s+", "", ln.spoken)) for ln in self.lines)


def fmt_mmss(chars: int, cpm: float, extra_sec: float = 0.0) -> str:
    total_sec = round((chars / cpm) * 60 + extra_sec)
    mm, ss = divmod(total_sec, 60)
    return f"{mm}分{ss:02d}秒"


@dataclass
class CueStats:
    se: int = 0
    bgm: int = 0
    pause: int = 0
    other: int = 0
    pause_sec: float = 0.0
    jingle_sec: float = 0.0

    @property
    def total(self) -> int:
        return self.se + self.bgm + self.pause + self.other

    @property
    def extra_sec(self) -> float:
        return self.pause_sec + self.jingle_sec


def detect_format_version(meta: dict[str, str], body_lines: list[str]) -> str:
    fmt = meta.get("format", "").strip().lower()
    if fmt == "v2":
        return "v2"
    if fmt == "v1":
        return "v1"
    if "speakers" in meta:
        return "v2"
    # Heuristic fallback: check whether ordinary lines use `<speaker>: ...`
    sample = [
        ln.strip()
        for ln in body_lines
        if ln.strip() and not ln.strip().startswith(("<!--", ">", "#", "---"))
    ]
    if sample and sum(1 for s in sample if SPEAKER_LINE_RE.match(s)) > len(sample) // 2:
        return "v2"
    return "v1"


def parse_script(path: Path) -> tuple[str, dict[str, str], list[SectionStats], CueStats, list[str]]:
    raw_lines = path.read_text(encoding="utf-8").splitlines()
    meta: dict[str, str] = {}
    sections: list[SectionStats] = []
    cues = CueStats()
    warnings: list[str] = []

    idx = 0
    if raw_lines and raw_lines[0].strip() == "---":
        idx = 1
        while idx < len(raw_lines) and raw_lines[idx].strip() != "---":
            line = raw_lines[idx].strip()
            if line and not line.startswith("#") and ":" in line:
                k, v = line.split(":", 1)
                meta[k.strip()] = v.strip().strip('"').strip("'")
            idx += 1
        if idx < len(raw_lines) and raw_lines[idx].strip() == "---":
            idx += 1
        else:
            warnings.append("先頭メタ情報の終端 '---' が見つかりません。")

    fmt_version = detect_format_version(meta, raw_lines[idx:])
    allowed_speakers: list[str] = []
    if fmt_version == "v2":
        chars_md = path.parent.parent / "characters.md"
        defined_in_chars: list[str] = []
        if chars_md.is_file():
            for cline in chars_md.read_text(encoding="utf-8").splitlines():
                cm = re.match(r"^###\s+.*`([A-Za-z][A-Za-z0-9_]*)`", cline.strip())
                if cm:
                    defined_in_chars.append(cm.group(1))
        if "speakers" in meta:
            allowed_speakers = [s.strip() for s in meta["speakers"].split(",") if s.strip()]
            if defined_in_chars:
                unknown = [s for s in allowed_speakers if s not in defined_in_chars]
                if unknown:
                    warnings.append(
                        f"メタ情報 speakers の {unknown} が characters.md ({defined_in_chars}) に定義されていません。"
                    )
        elif defined_in_chars:
            allowed_speakers = defined_in_chars

    in_comment = False
    current_section = SectionStats(title="(見出し前)")

    for lineno in range(idx + 1, len(raw_lines) + 1):
        raw = raw_lines[lineno - 1]
        stripped = raw.strip()

        if in_comment:
            if "-->" in stripped:
                in_comment = False
            continue
        if stripped.startswith("<!--"):
            if "-->" not in stripped:
                in_comment = True
            else:
                cm = COMMENT_CUE_RE.match(stripped)
                if cm:
                    kind, body = cm.group(1), cm.group(2)
                    sm = PAUSE_SEC_RE.search(body)
                    sec_val = float(sm.group(1)) if sm else 0.0
                    if kind == "SE":
                        cues.se += 1
                        cues.jingle_sec += sec_val
                    elif kind == "BGM":
                        cues.bgm += 1
                    elif kind == "間":
                        cues.pause += 1
                        cues.pause_sec += sec_val
                else:
                    cues.other += 1
            continue
        if not stripped or stripped.startswith(">"):
            continue
        if stripped == "---":
            continue
        if stripped.startswith("#"):
            heading = stripped.lstrip("#").strip()
            if current_section.lines:
                sections.append(current_section)
            current_section = SectionStats(title=heading)
            continue

        speaker: str | None = None
        visual: str | None = None
        fig_ref: str | None = None
        code_ref: str | None = None
        telop: str | None = None

        if fmt_version == "v1":
            m = V1_VISUAL_CUE_RE.search(raw)
            if m:
                visual = m.group(1).strip()
                spoken = raw[: m.start()].strip()
            else:
                spoken = stripped
        else:
            sm = SPEAKER_LINE_RE.match(stripped)
            if not sm:
                warnings.append(f"{lineno}行目: v2 発話行に '話者ID: セリフ' 形式がありません: {stripped}")
                rest = stripped
            else:
                speaker = sm.group(1)
                rest = sm.group(2).strip()
                if allowed_speakers and speaker not in allowed_speakers:
                    warnings.append(
                        f"{lineno}行目: 未定義の話者ID '{speaker}' です（許可: {allowed_speakers}）"
                    )

            tm = TRAILING_TAGS_RE.search(rest)
            if tm:
                tags_part = rest[tm.start() :]
                spoken = rest[: tm.start()].strip()
                tags = SINGLE_TAG_RE.findall(tags_part)
                order_indices: list[int] = []
                seen_keys: set[str] = set()
                for tkey, tval in tags:
                    tkey = tkey.strip()
                    tval = tval.strip()
                    if tkey not in V2_TAG_ORDER:
                        warnings.append(
                            f"{lineno}行目: v2 で未対応の行末指示 '[{tkey}: ...]' です（図・コード・テロップのみ可）"
                        )
                        continue
                    if tkey in seen_keys:
                        warnings.append(f"{lineno}行目: 行末指示 '[{tkey}: ...]' が重複しています")
                    seen_keys.add(tkey)
                    order_indices.append(V2_TAG_ORDER.index(tkey))
                    if tkey == "図":
                        fig_ref = tval
                    elif tkey == "コード":
                        code_ref = tval
                    elif tkey == "テロップ":
                        telop = tval
                if order_indices != sorted(order_indices):
                    warnings.append(
                        f"{lineno}行目: 行末指示の順序が不正です（図 → コード → テロップ の順にしてください）: {tags_part.strip()}"
                    )
            else:
                spoken = rest

            if not spoken:
                warnings.append(f"{lineno}行目: セリフ本文が空です。")

        if "<!--" in spoken or "-->" in spoken:
            warnings.append(f"{lineno}行目: 発話行内にコメント記法が含まれています（独立行にしてください）: {spoken}")

        if "[" in spoken or "]" in spoken:
            warnings.append(f"{lineno}行目: 発話本文に角括弧が残っています: {spoken}")

        # Check 1-line = 1-sentence rule (outside 「...」 / 『...』 quotes)
        unquoted = re.sub(r"「[^」]*」|『[^』]*』", "", spoken)
        unquoted_body = re.sub(r"(?:[。]|[！？!?]{1,2})$", "", unquoted)
        sent_endings = re.findall(r"[。！？!?]", unquoted_body)
        if sent_endings:
            warnings.append(f"{lineno}行目: 1行に複数の文末記号が含まれています: {spoken}")

        for phrase in FORBIDDEN_AUDIO_PHRASES:
            if phrase in spoken:
                warnings.append(f"{lineno}行目: 画面依存の表現 '{phrase}' が含まれています: {spoken}")

        current_section.lines.append(
            SpokenLine(
                lineno=lineno,
                spoken=spoken,
                speaker=speaker,
                visual=visual,
                fig_ref=fig_ref,
                code_ref=code_ref,
                telop=telop,
            )
        )

    if in_comment:
        warnings.append("閉じられていない HTML コメント '<!--' があります。")

    if current_section.lines:
        sections.append(current_section)

    return fmt_version, meta, sections, cues, warnings


def check_dictionary(sections: list[SectionStats], dict_path: Path) -> tuple[set[str], set[str], list[str]]:
    entries: dict[str, str] = {}
    dict_warnings: list[str] = []
    with dict_path.open(encoding="utf-8", newline="") as f:
        reader = csv.reader(f)
        header = next(reader, None)
        if not header or len(header) < 2:
            dict_warnings.append("dictionary.csv のヘッダーが不正です。")
        for row_no, row in enumerate(reader, start=2):
            if not row or not any(cell.strip() for cell in row):
                continue
            if len(row) < 3:
                dict_warnings.append(f"dictionary.csv {row_no}行目: 列数が3未満です。")
                continue
            surface, reading = row[0].strip(), row[1].strip()
            entries[surface] = reading
            if not re.fullmatch(r"[ァ-ヴー・]+", reading):
                dict_warnings.append(
                    f"dictionary.csv {row_no}行目: 読み '{reading}' にカタカナ以外の文字が含まれています。"
                )

    used_tokens: set[str] = set()
    for sec in sections:
        for ln in sec.lines:
            for tok in ASCII_TOKEN_RE.findall(ln.spoken):
                used_tokens.add(tok)

    missing = {tok for tok in used_tokens if tok not in entries}
    return used_tokens, missing, dict_warnings


def parse_figures_md(figures_path: Path) -> dict[str, str]:
    """Return mapping of fig_id -> raw markdown text of its ## section."""
    sections: dict[str, str] = {}
    current_id: str | None = None
    buf: list[str] = []
    for line in figures_path.read_text(encoding="utf-8").splitlines():
        if line.startswith("## "):
            if current_id is not None:
                sections[current_id] = "\n".join(buf)
            m = FIG_HEADING_RE.match(line.strip())
            current_id = m.group(1) if m else None
            buf = [line]
        elif current_id is not None:
            buf.append(line)
    if current_id is not None:
        sections[current_id] = "\n".join(buf)
    return sections


def check_v2_figures_and_code(
    script_path: Path, all_lines: list[SpokenLine]
) -> tuple[list[str], int, int]:
    """Validate all [図: ...] and [コード: ...] tags in a v2 script."""
    errors: list[str] = []
    ep_dir = script_path.parent
    figures_md = ep_dir / "figures.md"
    fig_dir = ep_dir / "fig"

    fig_occurrences = [(ln.lineno, ln.fig_ref) for ln in all_lines if ln.fig_ref is not None]
    code_occurrences = [(ln.lineno, ln.code_ref) for ln in all_lines if ln.code_ref is not None]

    defined_figs: dict[str, str] = {}
    if fig_occurrences:
        if not figures_md.is_file():
            errors.append(f"図定義ファイルが見つかりません: {figures_md}")
        else:
            defined_figs = parse_figures_md(figures_md)

    checked_svg_Targets: set[str] = set()
    for lineno, spec in fig_occurrences:
        m = FIG_SPEC_RE.match(spec)
        if not m:
            errors.append(
                f"{lineno}行目: 不正な図指定 '[図: {spec}]'（'図ID' または '図ID#ステップ番号' で指定してください）"
            )
            continue
        fig_id, step = m.group(1), m.group(2)
        svg_rel = f"fig/{fig_id}-{step}.svg" if step else f"fig/{fig_id}.svg"
        svg_path = ep_dir / svg_rel
        checked_svg_Targets.add(svg_rel)

        if defined_figs or figures_md.is_file():
            if fig_id not in defined_figs:
                errors.append(
                    f"{lineno}行目: 図ID '{fig_id}' が {figures_md.name} の見出し（## {fig_id}）に定義されていません"
                )
            else:
                sec_body = defined_figs[fig_id]
                if svg_rel not in sec_body and Path(svg_rel).name not in sec_body:
                    errors.append(
                        f"{lineno}行目: 図ステップ '{spec}' に対応する '{svg_rel}' の記述が {figures_md.name} の '{fig_id}' 節にありません"
                    )

        if not svg_path.is_file():
            errors.append(f"{lineno}行目: 図ファイルが見つかりません: {svg_path}")
        else:
            svg_text = svg_path.read_text(encoding="utf-8", errors="replace")
            if "<svg" not in svg_text or "</svg>" not in svg_text:
                errors.append(f"{lineno}行目: SVG ファイルの形式が不正です: {svg_path}")
            elif "Noto Sans JP" not in svg_text:
                errors.append(f"{lineno}行目: SVG に 'Noto Sans JP' フォント指定がありません: {svg_path}")

    # Also check if fig/ has valid directory when figures exist
    _ = fig_dir

    checked_code_refs: set[str] = set()
    doc_rel = (
        script_path.resolve().relative_to(REPO_ROOT.resolve()).as_posix()
        if script_path.resolve().is_relative_to(REPO_ROOT.resolve())
        else str(script_path)
    )
    for lineno, raw_ref in code_occurrences:
        try:
            norm_ref, rel_path, symbol = xv6refs.parse_ref_spec(raw_ref, doc_rel, lineno)
            xv6refs.resolve_ref(rel_path, symbol)
            checked_code_refs.add(norm_ref)
        except xv6refs.RefError as exc:
            errors.append(f"{lineno}行目: コード参照解決エラー [コード: {raw_ref}]: {exc}")

    return errors, len(checked_svg_Targets), len(checked_code_refs)


def resolve_default_bounds(script_path: Path, meta: dict[str, str]) -> tuple[int, int, int | None]:
    min_c, max_c = 2600, 3800
    max_line: int | None = None

    try:
        rel = script_path.resolve().relative_to((REPO_ROOT / "video" / "series").resolve())
        if rel:
            min_c, max_c = 6000, 6600
            max_line = 60
    except ValueError:
        pass

    if "target_chars" in meta:
        m = re.fullmatch(r"(\d+)\s*[-〜~]\s*(\d+)", meta["target_chars"].replace(",", ""))
        if m:
            min_c, max_c = int(m.group(1)), int(m.group(2))

    if "max_line_chars" in meta and meta["max_line_chars"].isdigit():
        max_line = int(meta["max_line_chars"])

    return min_c, max_c, max_line


def resolve_dict_path(script_path: Path, explicit_dict: str | None) -> Path | None:
    if explicit_dict:
        return Path(explicit_dict)
    local_dict = script_path.parent / "dictionary.csv"
    if local_dict.is_file():
        return local_dict
    parent_dict = script_path.parent.parent / "dictionary.csv"
    if parent_dict.is_file():
        return parent_dict
    return local_dict


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="scripts/script-stats",
        description="台本（script.md）の文数・文字数・推定尺・辞書・図解・コード参照を集計・検証します（v1/v2対応）。",
    )
    parser.add_argument(
        "script",
        nargs="?",
        default=str(DEFAULT_SCRIPT),
        help="集計対象の script.md パス（既定: video/ep01/script.md）",
    )
    parser.add_argument(
        "--dict",
        dest="dict_path",
        default=None,
        help="照合する dictionary.csv パス（省略時は同ディレクトリまたは親ディレクトリの dictionary.csv）",
    )
    parser.add_argument(
        "--min-chars",
        type=int,
        default=None,
        help="目標文字数の下限（省略時は通常 2600、video/series/ 配下は 6000）",
    )
    parser.add_argument(
        "--max-chars",
        type=int,
        default=None,
        help="目標文字数の上限（省略時は通常 3800、video/series/ 配下は 6600）",
    )
    parser.add_argument(
        "--max-line-chars",
        type=int,
        default=None,
        help="1文あたりの最大文字数上限（省略時は video/series/ 配下で 60、他は制限なし）",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="文字数範囲・1文長上限・1行1文・画面依存表現・辞書・図SVG・コード参照を厳格検証します。",
    )
    args = parser.parse_args()

    script_path = Path(args.script)
    if not script_path.is_file():
        print(f"[FAIL] 台本ファイルが見つかりません: {script_path}", file=sys.stderr)
        return 1

    fmt_version, meta, sections, cues, warnings = parse_script(script_path)
    all_lines = [ln for sec in sections for ln in sec.lines]
    if not all_lines:
        print(f"[FAIL] 発話行が1行も見つかりません: {script_path}", file=sys.stderr)
        return 1

    def_min, def_max, def_max_line = resolve_default_bounds(script_path, meta)
    min_chars = args.min_chars if args.min_chars is not None else def_min
    max_chars = args.max_chars if args.max_chars is not None else def_max
    max_line_chars = args.max_line_chars if args.max_line_chars is not None else def_max_line

    total_chars = sum(len(re.sub(r"\s+", "", ln.spoken)) for ln in all_lines)
    plain_chars = sum(len(PUNCT_RE.sub("", ln.spoken)) for ln in all_lines)
    lengths = [len(re.sub(r"\s+", "", ln.spoken)) for ln in all_lines]

    print(f"=== 台本統計: {script_path} ===")
    print(f"フォーマット : {fmt_version} ({'掛け合い・図解連動' if fmt_version == 'v2' else '旧形式・単一話者'})")
    if meta:
        if "program" in meta:
            print(f"番組名       : {meta['program']}")
        print(f"タイトル     : {meta.get('title', '(未設定)')}")
        if fmt_version == "v2":
            print(f"話者ID一覧   : {meta.get('speakers', '(未設定)')}")
        else:
            print(f"話者名（仮） : {meta.get('character', '(未設定)')}")
        print(f"対象コミット : {meta.get('target_commit', '(未設定)')}")
        print(f"参照章       : {meta.get('reference_chapter', '(未設定)')}")
    print(f"セクション数 : {len(sections)}")

    if fmt_version == "v1":
        visual_count = sum(1 for ln in all_lines if ln.visual is not None)
        print(f"文数（字幕数）: {len(all_lines)} 文（うち画面指示付き {visual_count} 文）")
    else:
        fig_count = sum(1 for ln in all_lines if ln.fig_ref is not None)
        code_count = sum(1 for ln in all_lines if ln.code_ref is not None)
        telop_count = sum(1 for ln in all_lines if ln.telop is not None)
        print(
            f"文数（字幕数）: {len(all_lines)} 文"
            f"（図指示 {fig_count} / コード指示 {code_count} / テロップ指示 {telop_count}）"
        )

    if cues.total > 0:
        print(
            f"演出コメント : {cues.total} 行（SE {cues.se} / BGM {cues.bgm} / 間 {cues.pause}"
            + (f" / 他 {cues.other}" if cues.other else "")
            + f"・指定秒数計 {cues.extra_sec:g}秒）"
        )
    print(
        f"本文文字数   : {total_chars:,} 字（空白除く・句読点込み、目標 {min_chars:,}〜{max_chars:,} 字）"
        f" / {plain_chars:,} 字（句読点・括弧除く）"
    )
    print(
        f"1文あたり長  : 平均 {total_chars / len(all_lines):.1f} 字 "
        f"（最短 {min(lengths)} 字 / 最長 {max(lengths)} 字"
        + (f" / 上限 {max_line_chars} 字" if max_line_chars is not None else "")
        + "）"
    )
    print(
        "推定尺（発話）: "
        f"300字/分 = {fmt_mmss(total_chars, 300)} | "
        f"315字/分 = {fmt_mmss(total_chars, 315)} | "
        f"330字/分 = {fmt_mmss(total_chars, 330)}"
    )
    if cues.extra_sec > 0:
        print(
            "推定尺（演出込）: "
            f"300字/分 = {fmt_mmss(total_chars, 300, cues.extra_sec)} | "
            f"315字/分 = {fmt_mmss(total_chars, 315, cues.extra_sec)} | "
            f"330字/分 = {fmt_mmss(total_chars, 330, cues.extra_sec)}"
        )

    if fmt_version == "v2":
        speaker_lines: Counter[str] = Counter()
        speaker_chars: Counter[str] = Counter()
        speaker_order: list[str] = []
        if "speakers" in meta:
            speaker_order = [s.strip() for s in meta["speakers"].split(",") if s.strip()]
        for ln in all_lines:
            sp = ln.speaker or "(不明)"
            if sp not in speaker_order:
                speaker_order.append(sp)
            speaker_lines[sp] += 1
            speaker_chars[sp] += len(re.sub(r"\s+", "", ln.spoken))
        print()
        print("--- 話者別内訳（目安尺は 315 字/分換算） ---")
        for sp in speaker_order:
            sc = speaker_chars[sp]
            sl = speaker_lines[sp]
            pct = (sc / total_chars * 100.0) if total_chars else 0.0
            print(f"  {sp:<8}: {sl:3d} 文 / {sc:4,d} 字 ({pct:4.1f}%) / 約 {fmt_mmss(sc, 315)}")

    print()
    print("--- セクション別内訳（目安尺は 315 字/分換算） ---")
    for sec in sections:
        c = sec.chars
        print(f"  {sec.title}: {len(sec.lines):3d} 文 / {c:4d} 字 / 約 {fmt_mmss(c, 315)}")

    dict_path = resolve_dict_path(script_path, args.dict_path)
    missing_tokens: set[str] = set()
    if dict_path and dict_path.is_file():
        used_tokens, missing_tokens, dict_warnings = check_dictionary(sections, dict_path)
        warnings.extend(dict_warnings)
        rel_dict = (
            dict_path.resolve().relative_to(REPO_ROOT.resolve())
            if dict_path.resolve().is_relative_to(REPO_ROOT.resolve())
            else dict_path
        )
        print()
        if missing_tokens:
            print(
                f"--- 辞書照合 ({rel_dict}): 未登録トークンあり {sorted(missing_tokens)} ---"
            )
        else:
            print(
                f"--- 辞書照合 ({rel_dict}): OK（本文中の英字トークン {len(used_tokens)} 種すべて登録済み） ---"
            )
    else:
        warnings.append(f"読み方辞書が見つかりません: {dict_path}")

    if fmt_version == "v2":
        v2_errors, uniq_svgs, uniq_codes = check_v2_figures_and_code(script_path, all_lines)
        warnings.extend(v2_errors)
        if not v2_errors:
            print(
                f"--- 図・コード参照検証: OK（SVG {uniq_svgs} 枚すべて figures.md・fig/*.svg 一致 / コード参照 {uniq_codes} 種解決済み） ---"
            )
        else:
            print(f"--- 図・コード参照検証: エラー {len(v2_errors)} 件 ---")

    full_text = script_path.read_text(encoding="utf-8")

    if fmt_version == "v1":
        char_name = meta.get("character", "")
        if char_name:
            spoken_char_count = sum(ln.spoken.count(char_name) for ln in all_lines)
            total_char_count = full_text.count(char_name)
            non_spoken_extra = total_char_count - 1 - spoken_char_count
            if non_spoken_extra != 0:
                warnings.append(
                    f"話者名 '{char_name}' がメタ情報と発話本文以外の箇所（見出し・注記・画面指示など）に含まれています。"
                )
            if spoken_char_count > 2:
                warnings.append(
                    f"話者名 '{char_name}' の本文出現回数が {spoken_char_count} 回です（差し替えやすいよう最小限・2回以内にしてください）。"
                )

        prog_name = meta.get("program", "")
        if prog_name:
            spoken_prog_count = sum(ln.spoken.count(prog_name) for ln in all_lines)
            total_prog_count = full_text.count(prog_name)
            non_spoken_prog_extra = total_prog_count - 1 - spoken_prog_count
            if non_spoken_prog_extra != 0:
                warnings.append(
                    f"番組名 '{prog_name}' がメタ情報と発話本文以外の箇所（見出し・注記・画面指示など）に含まれています。"
                )
            if spoken_prog_count > 3:
                warnings.append(
                    f"番組名 '{prog_name}' の本文出現回数が {spoken_prog_count} 回です（差し替えやすいよう最小限・3回以内にしてください）。"
                )

    if max_line_chars is not None:
        for ln in all_lines:
            slen = len(re.sub(r"\s+", "", ln.spoken))
            if slen > max_line_chars:
                warnings.append(
                    f"{ln.lineno}行目: 1文が {slen} 字あり上限（{max_line_chars}字）を超えています: {ln.spoken}"
                )

    if not (min_chars <= total_chars <= max_chars):
        warnings.append(
            f"本文文字数 {total_chars:,} 字が目標範囲（{min_chars:,}〜{max_chars:,}字）の外にあります。"
        )

    if warnings:
        print()
        print("--- 検証メッセージ ---")
        for w in warnings:
            print(f"  [WARN] {w}")

    if args.check and (warnings or missing_tokens):
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
