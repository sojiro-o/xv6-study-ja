#!/usr/bin/env python3
"""Temporarily apply a lab patch, build & test in QEMU, and always restore xv6-riscv/."""

import argparse
import hashlib
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import time

SCRIPTS_DIR = Path(__file__).resolve().parent
ROOT = SCRIPTS_DIR.parent
if str(SCRIPTS_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPTS_DIR))

from qemu_test import QemuSession, XV6  # noqa: E402


def run_syscall_trace(session: QemuSession) -> None:
    session.command(
        "echo hi",
        [
            rb"^\d+: syscall exec -> 2$",
            rb"^hi\d+: syscall write -> 2$",
            rb"^\d+: syscall write -> 1$",
        ],
    )
    ls_out = session.command("ls", [rb"^README\s+2\s+\d+\s+\d+"])
    if re.search(rb": syscall ", ls_out):
        raise RuntimeError("ls: echo 以外のプロセスでトレースが出力されました")


LAB_SPECS = {
    "syscall-trace": {
        "patch": ROOT / "docs" / "labs" / "syscall-trace.patch",
        "runner": run_syscall_trace,
        "timeout": 180,
    },
}


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def parse_patched_files(patch_path: Path) -> list[Path]:
    files: list[Path] = []
    for line in patch_path.read_text(encoding="utf-8").splitlines():
        if line.startswith("+++ b/"):
            rel = line[len("+++ b/") :].strip()
            target = (ROOT / rel).resolve()
            target.relative_to(ROOT.resolve())
            if target not in files:
                files.append(target)
    if not files:
        raise RuntimeError(f"{patch_path}: パッチ対象ファイルを特定できません")
    return files


def run_cmd(cmd: list[str]) -> None:
    subprocess.run(cmd, cwd=ROOT, check=True)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="scripts/check-lab",
        description="docs/labs/<名前>.patch を一時適用してビルド・QEMU 検証を行い、元に戻します。",
        epilog="例: scripts/check-lab syscall-trace",
    )
    parser.add_argument("lab", choices=sorted(LAB_SPECS.keys()), help="検証する改造実験の名前")
    args = parser.parse_args()

    spec = LAB_SPECS[args.lab]
    patch_path: Path = spec["patch"]
    if not patch_path.is_file():
        print(f"[FAIL] パッチが見つかりません: {patch_path}", file=sys.stderr)
        return 1

    touched_files = parse_patched_files(patch_path)
    original_hashes = {p: sha256_file(p) for p in touched_files}

    check_proc = subprocess.run(
        ["git", "apply", "--check", str(patch_path.relative_to(ROOT))],
        cwd=ROOT,
        capture_output=True,
        text=True,
    )
    if check_proc.returncode != 0:
        print(
            f"[FAIL] パッチを適用できません（作業ツリーに競合する変更がないか確認してください）:\n"
            f"{check_proc.stderr.strip()}",
            file=sys.stderr,
        )
        return 1

    def _on_signal(signum, _frame):
        raise KeyboardInterrupt(f"signal {signum}")

    old_sigint = signal.signal(signal.SIGINT, _on_signal)
    old_sigterm = signal.signal(signal.SIGTERM, _on_signal)

    timeout = float(os.environ.get("XV6_TEST_TIMEOUT", spec["timeout"]))
    log_path = os.environ.get(
        "XV6_TEST_LOG", str(ROOT / "logs" / f"lab-{args.lab}.log")
    )
    applied = False
    session: QemuSession | None = None
    started = time.monotonic()
    rc = 1

    try:
        print(f"[host] Applying {patch_path.relative_to(ROOT).as_posix()}")
        run_cmd(["git", "apply", str(patch_path.relative_to(ROOT))])
        applied = True

        session = QemuSession(log_path, timeout)
        session.start()
        spec["runner"](session)
        session.shutdown()
        session.record(
            f"[host] PASS lab-{args.lab} ({time.monotonic() - started:.1f}s)\n".encode()
        )
        rc = 0
    except (OSError, RuntimeError, TimeoutError, subprocess.SubprocessError, KeyboardInterrupt) as error:
        if session is not None:
            session.record(
                f"\n[host] FAIL lab-{args.lab}: {type(error).__name__}: {error}\n".encode()
            )
        else:
            print(f"[FAIL] lab-{args.lab}: {type(error).__name__}: {error}", file=sys.stderr)
        rc = 1
    finally:
        if session is not None:
            session.close()
        if applied:
            print(f"[host] Reverting {patch_path.relative_to(ROOT).as_posix()}")
            revert_proc = subprocess.run(
                ["git", "apply", "-R", str(patch_path.relative_to(ROOT))],
                cwd=ROOT,
                capture_output=True,
                text=True,
            )
            if revert_proc.returncode != 0:
                print(
                    f"[FAIL] git apply -R に失敗しました:\n{revert_proc.stderr.strip()}",
                    file=sys.stderr,
                )
                rc = 1
        for p, orig_hash in original_hashes.items():
            if sha256_file(p) != orig_hash:
                print(
                    f"[FAIL] {p.relative_to(ROOT)} のハッシュが元に戻っていません！",
                    file=sys.stderr,
                )
                rc = 1
        print("[host] Cleaning build artifacts in xv6-riscv/")
        subprocess.run(
            ["make", "-C", str(XV6), "clean"],
            cwd=ROOT,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        signal.signal(signal.SIGINT, old_sigint)
        signal.signal(signal.SIGTERM, old_sigterm)
        print(f"Log: {log_path}")

    return rc


if __name__ == "__main__":
    raise SystemExit(main())
